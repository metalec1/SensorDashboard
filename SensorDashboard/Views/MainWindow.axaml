<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SensorDashboard.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="using:SensorDashboard.Controls"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="SensorDashboard.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="SensorDashboard">

  
    
    
    <Grid RowDefinitions="*,*,*,*,*,*,*,*" ShowGridLines="True"
          ColumnDefinitions="*,*,*,*,*,*,*,*,*,*" Background="#a38f34">
       
        <ContentControl Content="{Binding BackgroundViewModel}" 
                        Grid.Column="{Binding GridColumnBackground}" Grid.Row="{Binding GridRowBackground}" Grid.ColumnSpan="{Binding GridColumnSpanBackground}" Grid.RowSpan="{Binding GridRowSpanBackground}"/>
        
        <Viewbox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2">
            <Button Classes="nav"  Command="{Binding ShowCameraDashboardCommand}" Content="Camera Dashboard"/>
        </Viewbox>
        <Viewbox Grid.Row="0" Grid.Column="4" Grid.ColumnSpan="1">
            <Button Classes="nav"  Command="{Binding ShowSettingsDashboardCommand}" Content="Settings"  />
        </Viewbox>
        <Viewbox Grid.Row="0" Grid.Column="7" Grid.ColumnSpan="1">
            <Button Classes="nav" Command="{Binding ShowIrCameraDashboardCommand}" Content="IrCamera"  />
        </Viewbox>
        
        
        
        
       
        
       
        <ContentControl Content="{Binding CurrentViewModel}" 
                        Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="10" Grid.RowSpan="6"/>
            
        
        <Border Grid.Row="7" Grid.ColumnSpan="10"  >
            <Border.Background>
                <SolidColorBrush Color="red" Opacity="0.4"/>
            </Border.Background>
        </Border>
        
    </Grid>
    
   


</Window>
