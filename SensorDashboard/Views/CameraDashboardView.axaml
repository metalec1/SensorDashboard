<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SensorDashboard.ViewModels"
             xmlns:controls="using:SensorDashboard.Controls"
             
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SensorDashboard.Views.CameraDashboardView"
             x:DataType="vm:CameraDashboardViewModel">
    
    <Grid RowDefinitions="*,*,*,*,*,*" ColumnDefinitions="*,*,*,*,*,*,*,*,*,*" ShowGridLines="True">
        
        <TextBlock Grid.ColumnSpan="5" Grid.RowSpan="3" 
                   Text="{Binding CurrentSensorState.Speed , StringFormat='Speed: {0}'}"  
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <controls:SensorStatusIndicator Grid.Row="0" Grid.Column="7" Width="30" Height="30" IsActive="{Binding CurrentSensorState.IsActive }"/>
            
    </Grid>
    <UserControl.Background>
        <SolidColorBrush Color="blue" Opacity="0.4" />
    </UserControl.Background>
    
</UserControl>
