<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SensorDashboard.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SensorDashboard.Views.BackgroundIrCameraView"
             x:DataType="vm:BackgroundIrCameraViewModel">
    <Image x:Name="Video" Source="{Binding PathToCameraImage}" Stretch="UniformToFill"/>
</UserControl>
