<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SensorDashboard.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SensorDashboard.Views.SettingsDashboardView"
             x:DataType="vm:SettingsDashboardViewModel">
    
    
    <Grid RowDefinitions="*,*,*,*,*,*"  ColumnDefinitions="*,*,*,*,*,*,*,*,*,*" ShowGridLines="True">
        
        <TextBlock Text="Settings Dashboard" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <Button Grid.Row="1" Grid.Column="0" Command="{Binding OpenGeneralSettingsCommand}" Content="General Settings" ></Button>
        <Button Grid.Row="2" Grid.Column="0" Command="{Binding OpenNetworkSettingsCommand}" Content="network"></Button>
        <Button Grid.Row="3" Grid.Column="0" Content="G1"></Button>
        <Button Grid.Row="4" Grid.Column="0" Content="G1"></Button>
        <ContentControl Content="{Binding CurrentMiniViewModel}" 
                        Grid.Column="2" Grid.Row="1" Grid.ColumnSpan="4" Grid.RowSpan="4"/>
    </Grid>
    <UserControl.Background>
        <SolidColorBrush Color="red" Opacity="0.6" />
    </UserControl.Background>
</UserControl>
