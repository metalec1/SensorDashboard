<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SensorDashboard.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SensorDashboard.Views.SettingsDashboardView"
             x:DataType="vm:SettingsDashboardViewModel">
    
    
    <Grid RowDefinitions="*,*,*,*,*,*"  ColumnDefinitions="*,*,*,*,*,*,*,*,*,*" ShowGridLines="True">
        
        <Viewbox Grid.Row="0" Grid.Column="0">
            <TextBlock Text="Settings Dashboard" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Viewbox>
        
        <Viewbox Grid.Row="1" Grid.Column="0">
            <Button Classes="nav"  
                    Command="{Binding OpenGeneralSettingsCommand}" 
                    Content="General Settings" />
        </Viewbox>
        <Viewbox Grid.Row="2" Grid.Column="0">
            <Button Classes="nav"  
                    Command="{Binding OpenNetworkSettingsCommand}" 
                    Content="Network Settings"/>
        </Viewbox>
        
        
        
        <ContentControl Content="{Binding CurrentMiniViewModel}" 
                        Grid.Column="2" Grid.Row="1" Grid.ColumnSpan="4" Grid.RowSpan="4"/>
    </Grid>
    <UserControl.Background>
        <SolidColorBrush Color="#b86c11" Opacity="0.3" />
    </UserControl.Background>
</UserControl>
