             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SensorDashboard.Views.GeneralSettingsView">
    
    <TextBlock Text="General Settings Menuuuuu!" HorizontalAlignment="Center" VerticalAlignment="Center"/>
